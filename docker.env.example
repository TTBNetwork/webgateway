# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://webgateway:change-me@192.168.2.254:7777/webgateway_local

# Master key for secrets at rest. Generate once:
#   openssl rand -hex 32
# Must be identical on the dashboard and every gateway.
SECRET_ENCRYPTION_KEY=

# Optional: panel service token(s), comma separated. Rotate by adding a new one
# and removing the old one on the next restart.
DASHBOARD_API_TOKENS=

# Optional: initial admin TOTP secret (base32). Generate:
#   python3 -c 'import base64,os;print(base64.b32encode(os.urandom(20)).decode().rstrip("="))'
# Leave empty to have the dashboard generate one (it is printed once in the logs).
DASHBOARD_ADMIN_TOTP_SECRET=

# Gateway identity / limits.
GATEWAY_NODE_NAME=docker
GATEWAY_NODE_COUNTRY=CN
GATEWAY_NODE_CITY=Local
GATEWAY_PORTS=80,443
GATEWAY_CACHE_MAX_SIZE=16777216
GATEWAY_MAX_CONNECTIONS=1024
