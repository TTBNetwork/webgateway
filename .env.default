
SUBNET_PREFIX=172.20.0

IMAGE_PREFIX=ghcr.io/ttbnetwork
IMAGE_PROJECT=webgateway

POSTGRES_IMAGE_PREFIX=ghcr.io/tianxiu2b2t
POSTGRES_TAG=latest
POSTGRES_USER=root
POSTGRES_PASSWORD=<password>
POSTGRES_DB=postgres
PG_MAX_CONN=100

DATA_DIR=./data

TZ=Asia/Shanghai

# DATABASE_URL=postgresql://root:<password>@webgateway-pg:5432/postgres

# ---- 访问日志 v2（按周分区）----
# 默认 off：启动只建 v2 空结构，不搬数据、不自动切换。
#   * 全新库：会直接把逻辑名交给 v2（access_request_logs 等即为分区表），无需人工操作。
#   * 老库（逻辑名上还是 v1 普通表）：需要显式激活一次 —— 见下面两项。
# 设为 auto 才是旧行为：后台自动搬完历史数据并自动回收 *_v1（不推荐，会把 v1 删掉）。
# ACCESS_LOG_V2=off

# 设为 1 时**启动即激活 v2**：logs 逻辑名交给 v2 分区表、v1 改名 *_v1 保留（不搬数据）。
# 推荐留 0，改用一次性命令（可控性更好，且能当场看到输出）：
#   docker compose exec gateway /opt/webgateway/gateway --activate-v2-keep-v1
# ACCESS_LOG_V2_ACTIVATE=0

# 只有 ACCESS_LOG_V2=auto（后台自动搬迁）时才有意义：
# 切换后等待多久再核对行数并回收 *_v1 旧表（秒，默认 300）；
# 设为 1 则永久保留 *_v1（需要回收磁盘时手工 DROP）。
# ACCESS_LOG_V2_DROP_V1_AFTER_SECS=300
# ACCESS_LOG_V2_KEEP_V1=1

# POSTGRES_ENCODE_USER=
# POSTGRES_ENCODE_PASSWORD=